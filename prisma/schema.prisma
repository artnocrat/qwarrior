datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  THEORY
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique // e.g. "EEG"
  courses   Course[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Level {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "100 Level"
  value     Int      @unique // e.g. 100
  courses   Course[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(STUDENT)
  xp        Int      @default(0)
  gameLevel Int      @default(1) // Renamed from level to avoid conflict
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  academicLevelId String?
  academicLevel   Level?      @relation(fields: [academicLevelId], references: [id])

  attempts      QuizAttempt[]
  badges        UserBadge[]
  ingestionJobs IngestionJob[]
}

model Course {
  id           String     @id @default(uuid())
  code         String     @unique // e.g. "GET 205"
  title        String
  description  String?
  semester     Int        @default(1)
  topics       Topic[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  levelId      String
  level        Level      @relation(fields: [levelId], references: [id])
}

model Topic {
  id        String     @id @default(uuid())
  name      String
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id])
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Question {
  id             String          @id @default(uuid())
  content        String          // The question text (can be markdown/html)
  type           QuestionType    @default(MULTIPLE_CHOICE)
  difficulty     Int             @default(1) // 1-5 scale
  topicId        String
  topic          Topic           @relation(fields: [topicId], references: [id])
  status         QuestionStatus  @default(DRAFT)
  ingestionJobId String?
  ingestionJob   IngestionJob?   @relation(fields: [ingestionJobId], references: [id])

  options     Option[]
  explanation Explanation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id         String   @id @default(uuid())
  content    String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Explanation {
  id         String   @id @default(uuid())
  content    String   // Detailed explanation text
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  score          Int      // Score achieved in this attempt
  totalQuestions Int
  correctAnswers Int
  completedAt    DateTime @default(now())
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  iconUrl     String?
  users       UserBadge[]
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model IngestionJob {
  id        String          @id @default(uuid())
  fileUrl   String
  fileType  String          // PDF, IMAGE, DOCX
  status    IngestionStatus @default(PENDING)
  adminId   String
  admin     User            @relation(fields: [adminId], references: [id])
  questions Question[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}
